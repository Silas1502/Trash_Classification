# Optional: relative paths are resolved from backend/. Leaving MODEL_PATH unset
# selects a checkpoint in backend/checkpoints/ or the monorepo's checkpoints/convnext_tiny/.
# MODEL_PATH=checkpoints/best_v2_convnext_retrained.keras
# MODEL_DOWNLOAD_URL=https://artifacts.example.com/best_v2_convnext_retrained.keras
# MODEL_SHA256=<64 hex characters; required when downloading>

# SAFETY_THRESHOLDS_PATH=app/core/safety_thresholds.json
ADAPTIVE_ASSESSMENT_ENABLED=false
TTA_VIEWS=5
SMART_CROP=false
# Alternate local directory containing u2netp.onnx (set in OS/Render env):
# U2NET_HOME=/path/to/u2net-cache

# 1. Supabase Database (Khuyên dùng)
SUPABASE_URL=
SUPABASE_KEY=

# 2. ImageKit Cloud Storage
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_BYTES=8388608
MAX_BATCH_FILES=20
MAX_BATCH_BYTES=33554432
MAX_IMAGE_PIXELS=16000000
INFERENCE_BATCH_SIZE=2
MAX_PREDICTION_REQUESTS=2
STORAGE_CONCURRENCY=4
HEALTH_PROBE_INTERVAL_SECONDS=30
